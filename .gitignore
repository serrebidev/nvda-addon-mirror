# Generated mirror output (synced to the web root, not tracked in main)
public/

# muse.ai side chat reused by the translation fill (local state per machine)
.muse-translate-thread

# Persistent sha256 cache (restored from the deployed site, not committed)
hashcache.json
githubOwnerCache.json
.bundlecache/

# Temporary Firecrawl research output
.firecrawl/

# Python
__pycache__/
*.pyc

localeCache.json
translationCache.json

# Polled upstream catalogs. Unlike the caches above this one is never published
# with the site either: no client reads it, and a cold start just re-polls.
sourceCache.json

# The memory sync writes its machine-specific block here when AGENTS.md is
# tracked, so absolute paths never reach a file the repo pushes.
AGENTS.local.md

# Pre-overlay text mirror.py hands to auto_translate.py; rebuilt every build.
autoTranslationSources.json

# Built helper add-on packages
dist/
